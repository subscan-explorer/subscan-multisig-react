{
  "name": "multisig",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "start": "vite --port 3008",
    "start:dev": "VITE_HOST_TYPE=dev vite --port 3008",
    "build": "npm run typecheck && vite build",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "cypress open",
    "stylelint": "stylelint \"src/**/*.scss\" --config stylelint.config.js",
    "i18next:scanner": "i18next-scanner --config i18next-scanner.config.js",
    "lint": "eslint ./src --ext .ts,.tsx -c .eslintrc.js --quiet",
    "changelog": "conventional-changelog -p eslint -i CHANGELOG.md -s -r 0",
    "format": "prettier ./src/**/*.tsx  --write",
    "typecheck": "tsc --noEmit",
    "test:components": "cypress open-ct",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run lint && npm run test:unit && npm run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && npm run lint && npm run stylelint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
